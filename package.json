{
	"name": "encryption-app",
	"version": "0.1.0",
	"description": "A password generator and Caesar cipher encryption/decryption tool built with React and TypeScript.",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"dependencies": {
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-icons": "5.7.0",
		"react-router-dom": "7.18.3"
	},
	"scripts": {
		"start": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"analyze": "tsc -b && ANALYZE=true vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -b"
	},
	"devDependencies": {
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/node": "22.20.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"globals": "17.12.0",
		"jiti": "2.7.0",
		"jsdom": "29.1.1",
		"prettier": "3.9.6",
		"rollup-plugin-visualizer": "7.1.1",
		"sass": "1.104.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.70.0",
		"vite": "8.3.0",
		"vitest": "4.1.10"
	}
}
